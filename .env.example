# =============================================================================
# Cosmodex — Local Development Environment
# =============================================================================
# Copy this file to `.env` and fill in values where indicated.
# The values pre-filled below are SAFE LOCAL DEFAULTS — do not use in production.
#
# HOW TO USE:
#   cp .env.example .env
#   docker compose up -d
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL Database
# DO NOT use special characters (!, #, @) in the password — they break
# the connection string URL parsing inside Docker containers.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=YourStrongLocalPassword2024
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# JWT Configuration
# JWT_SECRET must be at least 32 characters long.
# ANON_KEY and SERVICE_ROLE_KEY are HS256 JWTs signed with JWT_SECRET.
#
# The keys below are standard local dev keys signed with the default JWT_SECRET.
# They are safe to use locally. Regenerate for any non-local environment.
# -----------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Anon key — safe for use in browser/client code (limited permissions)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTg5MzQ1NjAwMH0.vh1-dwqULmDALnkn7fUv96Bl3iNGItPua0efQ5vGdoU

# Service role key — NEVER expose in browser. Use only in server-side code.
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxODkzNDU2MDAwfQ.ZhKwqCg2ywVpVox0tycMMG7XUhavS0REfb_R1hUSoec


# -----------------------------------------------------------------------------
# Internal service secrets (must be at least 32 characters)
# -----------------------------------------------------------------------------
PG_META_CRYPTO_KEY=your-pg-meta-crypto-key-at-least-32-chars
SECRET_KEY_BASE=your-realtime-secret-key-base-at-least-64-chars-long-here


# -----------------------------------------------------------------------------
# URLs — update these if you change ports or run on a remote machine
# -----------------------------------------------------------------------------
SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# PostgREST (REST API) configuration
# -----------------------------------------------------------------------------
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


# -----------------------------------------------------------------------------
# Supabase Studio dashboard
# -----------------------------------------------------------------------------
STUDIO_DEFAULT_PROJECT=Cosmodex
STUDIO_DEFAULT_ORGANIZATION=Cosmodex Org


# -----------------------------------------------------------------------------
# Kong API Gateway ports
# -----------------------------------------------------------------------------
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Dashboard basic-auth credentials for http://localhost:8000
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase


# -----------------------------------------------------------------------------
# Auth (GoTrue) settings
# -----------------------------------------------------------------------------
DISABLE_SIGNUP=false
ADDITIONAL_REDIRECT_URLS=


# -----------------------------------------------------------------------------
# Storage settings
# -----------------------------------------------------------------------------
STORAGE_TENANT_ID=stub
REGION=local


# -----------------------------------------------------------------------------
# Realtime settings
# -----------------------------------------------------------------------------
APP_NAME=realtime
FUNCTIONS_VERIFY_JWT=false


# -----------------------------------------------------------------------------
# Redis cache
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# Next.js public variables (safe to expose in browser bundles)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTg5MzQ1NjAwMH0.vh1-dwqULmDALnkn7fUv96Bl3iNGItPua0efQ5vGdoU